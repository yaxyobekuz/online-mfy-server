# Ikkinchi server uchun namuna.
#
# Ishlatish: shu faylni ikkinchi laptopdagi `server/.env` ga
# nusxalang (nomini `.env` qilib).
#
# Muhim: MONGODB_URI birinchi laptopning IP'siga qaraydi — ya'ni
# baza BITTA, server esa ikkita. Har server o'z IP'sidan tashqi
# API'ga chiqadi.

PORT=5000

# Birinchi laptopdagi MongoDB. IP o'zgarsa shu yerni yangilang.
MONGODB_URI=mongodb://192.168.0.225:27017/onlayn_mahalla

API_BASE_URL=https://api.online-mahalla.uz

# Shu server nomi. Interfeysda "Jarayon «ikkinchi» serverida
# ketmoqda" degan yozuvda shu ko'rinadi — qaysi yurishni kim olib
# borayotgani shundan bilinadi.
SERVER_NAME=ikkinchi
